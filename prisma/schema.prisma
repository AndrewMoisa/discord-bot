generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HireRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TimeEntryStatus {
  OPEN
  CLOSED
}

model Employee {
  id             String      @id @default(cuid())
  discordUserId  String      @unique
  displayName    String
  position       String
  department     String?
  notes          String?
  hiredById      String
  hiredAt        DateTime    @default(now())
  roleAssignedAt DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  timeEntries    TimeEntry[]

  @@index([discordUserId, isActive])
}

model HireRequest {
  id           String            @id @default(cuid())
  requesterId  String
  targetUserId String
  fullName     String
  cnp          String            @default("")
  phone        String            @default("")
  idCardUrl    String            @default("")
  referredBy   String            @default("")
  status       HireRequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewReason String?
  messageId    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([targetUserId])
}

model TimeEntry {
  id             String          @id @default(cuid())
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockInAt      DateTime        @default(now())
  clockOutAt     DateTime?
  durationMinutes Int?
  status         TimeEntryStatus @default(OPEN)
  sourceMessageId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([employeeId, status])
  @@index([clockInAt])
}

model GuildTenant {
  id             String      @id @default(cuid())
  guildId        String      @unique
  guildName      String
  schemaName     String      @unique
  isProvisioned  Boolean     @default(false)
  schemaVersion  Int         @default(0)
  lastError      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  config         GuildConfig?
  auditLogs      SetupAudit[]
}

model GuildConfig {
  id                        String      @id @default(cuid())
  guildTenantId             String      @unique
  guildTenant               GuildTenant @relation(fields: [guildTenantId], references: [id], onDelete: Cascade)
  employeeRoleId            String
  cvChannelId               String
  cvApprovedChannelId       String
  timesheetChannelId        String
  timesheetArchiveChannelId String
  timesheetSummaryChannelId String
  logChannelId              String
  managerRoleIds            String[]
  timezone                  String      @default("Europe/Bucharest")
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
}

model SetupAudit {
  id            String      @id @default(cuid())
  guildTenantId String
  guildTenant   GuildTenant @relation(fields: [guildTenantId], references: [id], onDelete: Cascade)
  actorUserId   String
  action        String
  status        String
  details       String?
  createdAt     DateTime    @default(now())

  @@index([guildTenantId, createdAt])
}
