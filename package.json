{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Discord HR manager bot for hiring and timesheets",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewMoisa/discord-bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AndrewMoisa/discord-bot/issues"
  },
  "homepage": "https://github.com/AndrewMoisa/discord-bot#readme",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.16.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
